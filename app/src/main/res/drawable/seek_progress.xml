<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape><solid android:color="@color/track" /><size android:height="3dp" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <clip><shape><solid android:color="@color/accent" /><size android:height="3dp" /><corners android:radius="2dp" /></shape></clip>
    </item>
</layer-list>
