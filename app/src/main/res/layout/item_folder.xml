<?xml version="1.0" encoding="utf-8"?>
<!-- A folder reads as a physical stack: the sheets above the poster show it holds more than one video. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="20dp">

    <View
        android:id="@+id/sheet_back"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginHorizontal="24dp"
        android:alpha="0.25"
        android:background="@drawable/bg_sheet" />

    <View
        android:id="@+id/sheet_front"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:alpha="0.45"
        android:background="@drawable/bg_sheet" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="184dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true"
        android:foreground="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/row_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.8"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
